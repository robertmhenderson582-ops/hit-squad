# Local / field-trial only. Never commit a real password.
# Copy to .env.local before `npm run dev`.

OWNER_EMAIL=robertmhenderson582@gmail.com
OWNER_NAME=Robert Henderson
OWNER_PASSWORD=hitsquad-field-trial-local

# Long random string used to sign the first-party session cookie.
AUTH_SECRET=change-me-to-a-long-random-string-for-local-dev

# Set true on HTTPS deploys. Local HTTP must stay false or the
# browser will not store the session cookie.
AUTH_COOKIE_SECURE=false

# Optional. Tickets write JSON to this path (never git). Local default is
# data/tickets.json (gitignored). On Vercel /tmp is cache only; live list is tickets.json in the Data room.
# TICKET_STORE_PATH=

# Optional. Emails each new ticket to OWNER_EMAIL so Novus has a Gmail copy.
# Desk list persists in the owner Drive vault. No paid database.
# TICKET_SMTP_URL=smtps://user:app-password@smtp.gmail.com:465
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# Owner Estimates room (Google Drive). Prefer user OAuth for writes.
# Never commit the client secret, refresh token, or service-account JSON.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional fallback. Reads still work; creates on consumer Gmail return 403.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# or:
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# Optional override. Default is the existing owner Estimates room.
# DRIVE_ESTIMATES_FOLDER_ID=
# Optional. Data room for companies.json, activity.json, tickets.json, seats.json, settings.json.
# Falls back to the Estimates room.
# DRIVE_DATA_FOLDER_ID=
# Optional. File id when the Data/Estimates folder is not listable by the service account.
# DRIVE_SEATS_FILE_ID=

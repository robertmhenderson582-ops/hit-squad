# Local / field-trial only. Never commit a real password.
# Copy to .env.local before `npm run dev`.

OWNER_EMAIL=robertmhenderson582@gmail.com
OWNER_NAME=Robert Henderson
OWNER_PASSWORD=hitsquad-field-trial-local

# Long random string used to sign the first-party session cookie.
AUTH_SECRET=change-me-to-a-long-random-string-for-local-dev

# Set true on HTTPS deploys. Local HTTP must stay false or the
# browser will not store the session cookie.
AUTH_COOKIE_SECURE=false

# Optional. Persists tester password hashes across serverless instances.
# Local claims also write data/seat-secrets.json (gitignored).
# BLOB_READ_WRITE_TOKEN=
